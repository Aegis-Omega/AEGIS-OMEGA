{
  "framework": "vite",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- :/hook-generator :/packages",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci --include=dev && npm ci --prefix ../packages/shared --include=dev",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
