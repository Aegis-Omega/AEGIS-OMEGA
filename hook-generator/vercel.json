{
  "framework": "vite",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- :/hook-generator :/packages",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "preview/hub/mcp-production-v1": false
    }
  }
}
