# Shared environment for Docker Compose, AEGIS MCP and the existing SDK/CLI.
# MCP loads the root .env; SDK/CLI callers export AEGIS_BASE_URL/AEGIS_API_KEY.
# Production:
AEGIS_BASE_URL=https://aegis-vertex.aegisomega.com
# Local runtime: AEGIS_BASE_URL=http://localhost:7890
AEGIS_API_KEY=
AEGIS_BRIDGE_PORT=7890
AEGIS_COCKPIT_PORT=3000
AEGIS_STUDIO_PORT=3001
AEGIS_PLATFORM_PORT=8081

# Server-side only; never use VITE_ prefixes for these values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-east5

# Existing Automaton-3 inputs, supplied by an authenticated authority producer.
AEGIS_EXECUTION_IDENTITY_JSON=
AEGIS_WORKSPACE_OBSERVATION_JSON=
AEGIS_APPROVAL_GRANT_JSON=
