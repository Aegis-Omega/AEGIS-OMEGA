{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "git": {
    "deploymentEnabled": {
      "product/tameion-evidence-passport-v1": false
    }
  },
  "ignoreCommand": "test \"$VERCEL_GIT_COMMIT_REF\" = \"product/tameion-evidence-passport-v1\"",
  "buildCommand": "cd hub && npm install && npm run build",
  "outputDirectory": "hub/dist",
  "installCommand": "echo 'install handled per-product'",
  "rewrites": [{"source": "/(.*)", "destination": "/index.html"}]
}
