# Stripe payment links — create at dashboard.stripe.com → Payment Links
# Operator ($49): add metadata key "tier" = "operator" on the link
# Sovereign ($499): add metadata key "tier" = "sovereign" on the link
VITE_STRIPE_OPERATOR_LINK=https://buy.stripe.com/REPLACE_ME
VITE_STRIPE_SOVEREIGN_LINK=https://buy.stripe.com/REPLACE_ME

# Stripe webhook — add in dashboard.stripe.com → Webhooks:
#   Endpoint URL: https://rwehltdwpsncnwxzkwik.supabase.co/functions/v1/verify-stripe
#   Events: checkout.session.completed
# Then set the signing secret:
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_... --project-ref rwehltdwpsncnwxzkwik

# Tool deployment URLs
VITE_URL_PLATFORM_PICKER=https://platform.aegisomega.com
VITE_URL_HOOK_GENERATOR=https://hooks.aegisomega.com
VITE_URL_CONTENT_CALENDAR=https://calendar.aegisomega.com

# Supabase backend (aegis-omega project, eu-central-1)
VITE_SUPABASE_URL=https://rwehltdwpsncnwxzkwik.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJ3ZWhsdGR3cHNuY253eHprd2lrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk4ODAxMzIsImV4cCI6MjA5NTQ1NjEzMn0.TRPorur3ZbaVn_H9yLJJp2Hoi3BXlxeP1qOQRu7pJJg

# Token signing secret (must match across all products)
VITE_GRANT_SECRET=aegis-omega-v1

# OpenAI Ads Measurement Pixel (public browser identifier, not a secret).
# Create the Pixel in OpenAI Ads Manager, then set the same ID server-side
# as OPENAI_ADS_PIXEL_ID for Pixel+CAPI deduplication.
VITE_OPENAI_ADS_PIXEL_ID=

# OpenAI Ads CAPI credentials are server-only Supabase function secrets.
# Never prefix the CAPI key with VITE_ and never place it in this file.
# Example provisioning command (supply values securely):
#   supabase secrets set OPENAI_ADS_PIXEL_ID=... OPENAI_ADS_CAPI_KEY=... \
#     OPENAI_ADS_SITE_ORIGIN=https://aegisomega.com OPENAI_ADS_VALIDATE_ONLY=false
