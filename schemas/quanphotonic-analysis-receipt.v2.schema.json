{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://aegisomega.com/schemas/quanphotonic-analysis-receipt.v2.schema.json","title":"QuanPhotonic AnalysisReceiptV2","type":"object","additionalProperties":false,
