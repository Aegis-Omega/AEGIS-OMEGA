{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aegisomega",
  "main": "worker-src/index.ts",
  "compatibility_date": "2026-06-08",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "bash scripts/cloudflare-gq-full-replay.sh"
  },
  "assets": {
    "directory": "aegisomega-webgpu",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    { "pattern": "aegis-vertex.aegisomega.com", "custom_domain": true }
  ]
}
