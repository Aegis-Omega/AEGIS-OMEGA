{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegisomega.com/schemas/claim-promotion-request.v1.schema.json",
  "title": "AEGIS v0.4 Claim Promotion Requests",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "baseline_digest", "requests"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": "0.4" },
    "baseline_digest": { "$ref": "#/$defs/digest" },
    "requests": {
      "type": "array",
      "items": { "$ref": "#/$defs/request" }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition_id", "status"],
      "properties": {
        "transition_id": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": [
            "MACHINE_BOUND",
            "EXTERNAL_ESTABLISHED",
            "TARGET_OPEN",
            "NOT_ESTABLISHED",
            "ADMITTED"
          ]
        }
      }
    },
    "redContract": {
      "type": "object",
      "additionalProperties": true,
      "required": ["contract_id", "falsifiers", "mandatory_transitions"],
      "properties": {
        "contract_id": { "type": "string", "minLength": 1 },
        "falsifiers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "mandatory_transitions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "baseline_digest",
        "final_epistemic_status",
        "red_contract",
        "implementation_files",
        "negative_control_receipts",
        "verification_receipts",
        "required_transitions"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^CLM-\\d{3}$"
        },
        "baseline_digest": { "$ref": "#/$defs/digest" },
        "final_epistemic_status": {
          "type": "string",
          "enum": ["MACHINE_BOUND", "EMPIRICAL", "TARGET_OPEN"]
        },
        "red_contract": { "$ref": "#/$defs/redContract" },
        "implementation_files": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "negative_control_receipts": {
          "type": "array",
          "items": { "type": "object", "minProperties": 1 }
        },
        "verification_receipts": {
          "type": "array",
          "items": { "type": "object", "minProperties": 1 }
        },
        "required_transitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/transition" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "final_epistemic_status": {
                "enum": ["MACHINE_BOUND", "EMPIRICAL"]
              }
            },
            "required": ["final_epistemic_status"]
          },
          "then": {
            "properties": {
              "implementation_files": { "minItems": 1 },
              "negative_control_receipts": { "minItems": 1 },
              "verification_receipts": { "minItems": 1 },
              "required_transitions": { "minItems": 1 },
              "red_contract": {
                "properties": {
                  "mandatory_transitions": { "minItems": 1 }
                }
              }
            }
          }
        }
      ]
    }
  }
}
