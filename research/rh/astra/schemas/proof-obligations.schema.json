{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AEGIS RH Proof Obligation DAG V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["specification","frontier","rh_status","claim_promotion","execution_release","authority_effect","normalization","candidate_next_obligation","nodes"],
  "properties": {
    "specification": {"const":"AEGIS_RH_PROOF_OBLIGATION_DAG_V1"},
    "frontier": {"type":"object"},
    "rh_status": {"enum":["NOT_PROVEN","PROVEN","DISPROVEN"]},
    "claim_promotion": {"enum":["BLOCKED","BOUNDED_ONLY","ALLOWED"]},
    "execution_release": {"const":"BLOCKED"},
    "authority_effect": {"const":"NONE"},
    "normalization": {"type":"object"},
    "candidate_next_obligation": {"type":"object"},
    "nodes": {
      "type":"array","minItems":1,
      "items": {
        "type":"object","additionalProperties":true,
        "required":["id","statement","status","dependencies","proof_binding","authority_ceiling","source_basis"],
        "properties": {
          "id":{"type":"string","minLength":1},
          "statement":{"type":"string","minLength":1},
          "status":{"enum":["PROVED_MACHINE_CHECKED","HOSTED_EXACT_HEAD_COMPILE_VERIFIED","PROVED_PAPER_LEVEL","NUMERICALLY_VERIFIED","CONDITIONAL","ASSUMPTION_BEARING","SEMANTIC_BRIDGE_OPEN","OPEN","MISSING","REFUTED"]},
          "dependencies":{"type":"array","items":{"type":"string"}},
          "proof_binding":{"type":["object","null"]},
          "authority_ceiling":{"type":"string"},
          "source_basis":{"type":"string"}
        }
      }
    }
  }
}
