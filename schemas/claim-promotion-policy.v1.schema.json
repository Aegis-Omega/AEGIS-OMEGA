    "baseline_digest": {
      "const": "457f4566cb932d3f91e2265632fad9931c709645e520471095c23000a85c6404"
    },
    "open_transition_statuses": {
      "const": ["TARGET_OPEN", "NOT_ESTABLISHED"]
    },
    "machine_bound_forbidden_if_any": {
      "const": ["EXTERNAL_ESTABLISHED", "TARGET_OPEN", "NOT_ESTABLISHED"]
    }
  }
}
