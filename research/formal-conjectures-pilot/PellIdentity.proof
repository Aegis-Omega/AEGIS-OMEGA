  have pair : ∀ m : ℕ,
      pellNumber (2 * m + 1) = pellNumber m ^ 2 + pellNumber (m + 1) ^ 2 ∧
      pellNumber (2 * m + 2) = 2 * pellNumber (m + 1) * (pellNumber m + pellNumber (m + 1)) := by
    intro m
    induction m with
    | zero => norm_num [pellNumber]
    | succ m ih =>
      have rec₁ : pellNumber (2 * (m + 1) + 1) =
          2 * pellNumber (2 * m + 2) + pellNumber (2 * m + 1) := by
        conv_lhs => rw [show 2 * (m + 1) + 1 = (2 * m + 1) + 1 + 1 by omega]
        rw [pellNumber]
      have rec₂ : pellNumber (2 * (m + 1) + 2) =
          2 * pellNumber (2 * (m + 1) + 1) + pellNumber (2 * m + 2) := by
        conv_lhs => rw [show 2 * (m + 1) + 2 = (2 * m + 2) + 1 + 1 by omega]
        rw [pellNumber]
        congr 2
      have step : pellNumber (m + 1 + 1) =
          2 * pellNumber (m + 1) + pellNumber m := rfl
      constructor
      · change pellNumber (2 * (m + 1) + 1) = _
        rw [rec₁, ih.1, ih.2, step]
        ring
      · change pellNumber (2 * (m + 1) + 2) = _
        rw [rec₂, rec₁, ih.1, ih.2, step]
        ring
  exact (pair n).1
