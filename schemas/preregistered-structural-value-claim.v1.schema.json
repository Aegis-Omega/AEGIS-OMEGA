{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-omega.local/schemas/preregistered-structural-value-claim.v1.schema.json",
  "title": "PreregisteredStructuralValueClaimV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_kind",
    "campaign_root",
    "comparison_task_population_commitment",
    "compute_matched_baseline_root",
    "calibration_roots"
  ],
  "properties": {
    "claim_kind": {"const": "PREREGISTERED_STRUCTURAL_VALUE_CLAIM_V1"},
    "campaign_root": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "comparison_task_population_commitment": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "compute_matched_baseline_root": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "calibration_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"}
    }
  }
}
