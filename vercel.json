{
  "framework": "vite",
  "buildCommand": "cd hub && npm install && npm run build",
  "outputDirectory": "hub/dist",
  "installCommand": "echo 'install handled per-product'",
  "rewrites": [
    {
      "source": "/labs/mcp",
      "destination": "/labs/mcp/index.html"
    },
    {
      "source": "/labs/mcp/",
      "destination": "/labs/mcp/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/labs/mcp/:path*",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
