{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-omega.local/schemas/campaign-evidence-bundle.v1.schema.json",
  "title": "CampaignEvidenceBundleV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_kind",
    "campaign_root",
    "paired_trial_roots",
    "pair_verification_roots",
    "benchmark_adapter_executable_commitment",
    "runner_environment_commitment",
    "execution_receipt_bundle_commitment",
    "evidence_status"
  ],
  "properties": {
    "bundle_kind": {"const": "CAMPAIGN_EVIDENCE_BUNDLE_V1"},
    "campaign_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "paired_trial_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "pair_verification_roots": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"}
    },
    "benchmark_adapter_executable_commitment": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "runner_environment_commitment": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "execution_receipt_bundle_commitment": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "evidence_status": {
      "enum": [
        "NOT_EVALUATED",
        "DEVELOPMENT_EVIDENCE_ONLY",
        "HELD_OUT_EVIDENCE_COMPLETE",
        "INVALIDATED_CONTAMINATION"
      ]
    }
  }
}
