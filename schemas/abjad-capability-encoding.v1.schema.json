{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegisomega.com/schemas/abjad-capability-encoding.v1.schema.json",
  "title": "AbjadCapabilityEncodingV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_kind",
    "schema_version",
    "derivation_kind",
    "epistemic_ceiling",
    "source_digest",
    "abjad_system",
    "candidate_encodings",
    "ambiguity_preserved"
  ],
  "properties": {
    "record_kind": { "const": "ABJAD_CAPABILITY_ENCODING_V1" },
    "schema_version": { "const": "1.0.0" },
    "derivation_kind": { "const": "DETERMINISTIC_FROM_UNTRUSTED_OBSERVATION" },
    "epistemic_ceiling": { "const": "T2" },
    "source_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "abjad_system": {
      "enum": ["MASHRIQI_V1", "MAGHRIBI_V1"]
    },
    "candidate_encodings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/candidate_encoding" }
    },
    "ambiguity_preserved": { "type": "boolean" }
  },
  "$defs": {
    "grapheme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_form",
        "abjad_letter",
        "dot_count",
        "dot_evidence",
        "diacritics"
      ],
      "properties": {
        "surface_form": { "type": "string", "minLength": 1 },
        "abjad_letter": {
          "enum": [
            "ا", "ب", "ج", "د", "ه", "و", "ز", "ح", "ط", "ي",
            "ك", "ل", "م", "ن", "س", "ع", "ف", "ص", "ق", "ر",
            "ش", "ت", "ث", "خ", "ذ", "ض", "ظ", "غ"
          ]
        },
        "dot_count": { "type": "integer", "minimum": 0, "maximum": 3 },
        "dot_evidence": { "enum": ["OBSERVED", "INFERRED", "NOT_VISIBLE"] },
        "diacritics": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_region": { "type": "string" },
        "trajectory_segment": { "type": "string" }
      }
    },
    "letter_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "abjad_value",
        "digital_root",
        "family",
        "dodecagon_node",
        "opposite_node",
        "dot_count",
        "cycle_length"
      ],
      "properties": {
        "abjad_value": { "type": "integer", "minimum": 1 },
        "digital_root": { "type": "integer", "minimum": 1, "maximum": 9 },
        "family": { "enum": ["TRIADIC", "HEXADIC"] },
        "dodecagon_node": { "type": "integer", "minimum": 0, "maximum": 11 },
        "opposite_node": { "type": "integer", "minimum": 0, "maximum": 11 },
        "dot_count": { "type": "integer", "minimum": 0, "maximum": 3 },
        "cycle_length": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "candidate_encoding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "confidence_bps",
        "graphemes",
        "derived_abjad_values",
        "letter_records",
        "abjad_sum",
        "abjad_product",
        "sum_dr",
        "product_dr",
        "sum_family",
        "product_family",
        "name_node",
        "routing_path",
        "is_self_referential"
      ],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "confidence_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "graphemes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/grapheme" }
        },
        "derived_abjad_values": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "letter_records": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/letter_record" }
        },
        "abjad_sum": { "type": "integer", "minimum": 1 },
        "abjad_product": { "type": "integer", "minimum": 1 },
        "sum_dr": { "type": "integer", "minimum": 1, "maximum": 9 },
        "product_dr": { "type": "integer", "minimum": 1, "maximum": 9 },
        "sum_family": { "enum": ["TRIADIC", "HEXADIC"] },
        "product_family": { "enum": ["TRIADIC", "HEXADIC"] },
        "name_node": { "type": "integer", "minimum": 0, "maximum": 11 },
        "routing_path": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0, "maximum": 11 }
        },
        "is_self_referential": { "type": "boolean" }
      }
    }
  }
}
