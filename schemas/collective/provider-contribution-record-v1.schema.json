{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-omega.local/schemas/collective/provider-contribution-record-v1.schema.json",
  "title": "AEGIS UCI Provider Contribution Record V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "record_hash",
    "graph_id",
    "work_node_id",
    "provider",
    "model",
    "session_id",
    "session_head_sha",
    "lease_owner_identity",
    "lease_generation",
    "fencing_token",
    "artifact_sha256",
    "contribution_store_prestate_root",
    "intent_digest",
    "policy_commitment",
    "authority_epoch",
    "target_commitment",
    "pre_state_commitment",
    "authority"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "record_kind": { "const": "PROVIDER_CONTRIBUTION_RECORD_V1" },
    "record_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "graph_id": { "type": "string", "pattern": "^[A-Za-z0-9._:/@+\\-]{1,128}$" },
    "work_node_id": { "type": "string", "pattern": "^[A-Za-z0-9._:/@+\\-]{1,128}$" },
    "provider": { "type": "string", "pattern": "^[A-Za-z0-9._:/@+\\-]{1,128}$" },
    "model": { "type": "string", "pattern": "^[A-Za-z0-9._:/@+\\-]{1,128}$" },
    "session_id": { "type": "string", "pattern": "^[A-Za-z0-9._:/@+\\-]{1,128}$" },
    "session_head_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "lease_owner_identity": { "type": "string", "pattern": "^[A-Za-z0-9._:/@+\\-]{1,128}$" },
    "lease_generation": { "type": "integer", "minimum": 1 },
    "fencing_token": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "contribution_store_prestate_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "intent_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "policy_commitment": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "authority_epoch": { "type": "integer", "minimum": 0 },
    "target_commitment": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "pre_state_commitment": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "authority": { "const": "NON_AUTHORITATIVE_EVIDENCE" }
  }
}
