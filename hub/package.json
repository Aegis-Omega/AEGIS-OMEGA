{
  "name": "hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:integrity": "node --experimental-strip-types --test tests/artifact-integrity.test.mjs tests/clipboard-revision.test.mjs",
    "test:console": "node --test tests/console-observation.test.mjs",
    "test:experience": "node --experimental-strip-types --test tests/holon-interaction.test.mjs tests/disclosure.test.mjs tests/holon-legibility.test.mjs tests/navigation-contract.test.mjs tests/evidence-filament.test.mjs tests/field-topology.test.mjs tests/research-visual-fusion.test.mjs tests/sovereign-matter-3d.test.mjs tests/holon-shader-integrity.test.mjs tests/visual-universe.test.mjs tests/cosmic-command.test.mjs tests/command-palette.test.mjs tests/holon-maximus.test.mjs tests/holon-thread.test.mjs",
    "test:field": "node --experimental-strip-types --test tests/field-topology.test.mjs",
    "test:design": "node --test tests/visual-universe.test.mjs",
    "test:cosmic": "node --test tests/cosmic-command.test.mjs",
    "test:command": "node --experimental-strip-types --test tests/command-palette.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "lucide-react": "^1.16.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.16"
  }
