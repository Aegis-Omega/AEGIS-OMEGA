{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://aegisomega.com/schemas/quanphotonic-measurement-batch.v2.schema.json","title":"QuanPhotonic MeasurementBatchEnvelopeV2","type":"object","additionalProperties":false,
