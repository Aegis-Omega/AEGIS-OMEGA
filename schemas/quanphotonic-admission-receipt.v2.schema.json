{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://aegisomega.com/schemas/quanphotonic-admission-receipt.v2.schema.json","title":"QuanPhotonic AdmissionReceiptV2","type":"object","additionalProperties":false,
  "required":["schema_version","admission_receipt_id","admission_receipt_digest","evidence_join_digest","analysis_receipt_digest","biological_context_digest","classical_covariate_manifest_digest","policy_digest","decision","reason_codes","observed_at_utc"],
