{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-omega/schemas/math-verification/math-claim-envelope-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","claim_kind","claim_id","claim_text_digest","claim_digest","assumptions_digest","notation_digest","source_artifact_digests","policy_commitment","authority_epoch","nonce","authority"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "claim_kind": {"const": "MATH_CLAIM_ENVELOPE_V1"},
    "claim_id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._:/@+\\-]+$"},
    "claim_text_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claim_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assumptions_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "notation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_artifact_digests": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "policy_commitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_epoch": {"type": "integer", "minimum": 0},
    "nonce": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._:/@+\\-]+$"},
    "authority": {"const": "NON_AUTHORITATIVE_MATH_CLAIM"}
  }
}