{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AVDTrialReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "authority_class",
    "execution_mode",
    "trial_id",
    "arm_id",
    "anchor",
    "submission",
    "commitment_digests",
    "resource_telemetry",
    "oracle_falsifier_outcomes",
    "isolation_attestation",
    "gate_outcome",
    "receipt_digest"
  ],
  "properties": {
    "protocol_version": {"type": "string", "enum": ["AVD_PROTOCOL_V1"]},
    "authority_class": {"type": "string", "enum": ["NONE"]},
    "execution_mode": {"type": "string", "enum": ["BENCHMARK_MEASUREMENT_ONLY"]},
    "trial_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "arm_id": {"type": "string", "enum": ["ARM_A_HUMAN", "ARM_B_AEDR_AUTONOMOUS", "ARM_C_MONOLITHIC_ORACLE"]},
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "tree_sha", "pr_base_sha", "git_parent_sha"],
      "properties": {
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "pr_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "git_parent_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patch_sha256", "result_tree_sha256"],
      "properties": {
        "patch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "result_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "commitment_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["h_problem", "h_verifier", "h_oracle"],
      "properties": {
        "h_problem": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "h_verifier": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "h_oracle": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "resource_telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_nanoseconds",
        "active_nanoseconds",
        "human_active_nanoseconds",
        "machine_active_nanoseconds",
        "cpu_user_microseconds",
        "cpu_system_microseconds",
        "input_tokens",
        "output_tokens",
        "tool_actions",
        "model_calls",
        "gpu_seconds",
        "cached_tokens",
        "api_cost_usd"
      ],
      "properties": {
        "wall_nanoseconds": {"type": "integer", "minimum": 0},
        "active_nanoseconds": {"type": "integer", "minimum": 0},
        "human_active_nanoseconds": {"type": "integer", "minimum": 0},
        "machine_active_nanoseconds": {"type": "integer", "minimum": 0},
        "cpu_user_microseconds": {"type": "integer", "minimum": 0},
        "cpu_system_microseconds": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "tool_actions": {"type": "integer", "minimum": 0},
        "model_calls": {"type": "integer", "minimum": 0},
        "gpu_seconds": {"type": "string", "enum": ["UNAVAILABLE"]},
        "cached_tokens": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "string", "enum": ["UNAVAILABLE"]}
          ]
        },
        "api_cost_usd": {"type": "string", "enum": ["UNAVAILABLE"]}
      }
    },
    "oracle_falsifier_outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_semantic", "proof_integrity", "provenance_verifier"],
      "properties": {
        "candidate_semantic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["MUT_01", "MUT_02", "MUT_03", "MUT_04", "MUT_05", "MUT_06", "MUT_15"],
          "properties": {
            "MUT_01": {"type": "string", "enum": ["PASS", "FAIL"]},
            "MUT_02": {"type": "string", "enum": ["PASS", "FAIL"]},
            "MUT_03": {"type": "string", "enum": ["PASS", "FAIL"]},
            "MUT_04": {"type": "string", "enum": ["PASS", "FAIL"]},
            "MUT_05": {"type": "string", "enum": ["PASS", "FAIL"]},
            "MUT_06": {"type": "string", "enum": ["PASS", "FAIL"]},
            "MUT_15": {"type": "string", "enum": ["PASS", "FAIL"]}
          }
        },
        "proof_integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["MUT_07", "MUT_08", "MUT_09", "MUT_10"],
          "properties": {
            "MUT_07": {"type": "string", "enum": ["PASS", "FAIL"]},
            "MUT_08": {"type": "string", "enum": ["PASS", "FAIL"]},
            "MUT_09": {"type": "string", "enum": ["PASS", "FAIL"]},
            "MUT_10": {"type": "string", "enum": ["PASS", "FAIL"]}
          }
        },
        "provenance_verifier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["MUT_11", "MUT_12", "MUT_13", "MUT_14"],
          "properties": {
            "MUT_11": {"type": "string", "enum": ["PASS", "FAIL"]},
            "MUT_12": {"type": "string", "enum": ["PASS", "FAIL"]},
            "MUT_13": {"type": "string", "enum": ["PASS", "FAIL"]},
            "MUT_14": {"type": "string", "enum": ["PASS", "FAIL"]}
          }
        }
      }
    },
    "isolation_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_git_metadata_absent", "candidate_network_mode", "fresh_clean_room_context", "external_repo_tools_disabled", "future_solution_absent_at_start"],
      "properties": {
        "workspace_git_metadata_absent": {"type": "boolean", "const": true},
        "candidate_network_mode": {"type": "string", "enum": ["NONE"]},
        "fresh_clean_room_context": {"type": "boolean", "const": true},
        "external_repo_tools_disabled": {"type": "boolean", "const": true},
        "future_solution_absent_at_start": {"type": "boolean", "const": true}
      }
    },
    "gate_outcome": {"type": "string", "enum": ["PASS", "FAIL", "REJECTED_VERIFIER_COMPROMISE", "QUARANTINED"]},
    "receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
