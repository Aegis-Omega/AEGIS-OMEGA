{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://aegisomega.com/schemas/aegis-evidence-join.v2.biological.schema.json",
  "title":"AEGIS Evidence Join V2 Biological",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","created_at_utc","biological_context_digest","classical_covariate_manifest_digest","join_policy","artifacts","claims","join_summary","digest_scope","packet_digest_sha256"],
  "properties":{
    "schema":{"const":"AEGIS_EVIDENCE_JOIN_V2"},
    "created_at_utc":{"type":"string","format":"date-time"},
    "biological_context_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "classical_covariate_manifest_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "join_policy":{"type":"object","additionalProperties":false,"required":["authority_invariant","promotion_rule","missing_evidence_behavior"],"properties":{"authority_invariant":{"type":"string","minLength":1},"promotion_rule":{"type":"string","minLength":1},"missing_evidence_behavior":{"const":"FAIL_CLOSED"}}},
    "artifacts":{"type":"array","minItems":8,"items":{"type":"object","additionalProperties":false,"required":["artifact_id","filename","sha256","role","authority_scope"],"properties":{"artifact_id":{"type":"string","minLength":1},"filename":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"role":{"type":"string","minLength":1},"authority_scope":{"enum":["BIOLOGICAL_CONTEXT_MANIFEST","CLASSICAL_COVARIATE_MANIFEST","CLASSICAL_FEATURE_PAYLOAD","CALIBRATION_RECEIPT","MEASUREMENT_BATCH","RAW_DETECTOR_PAYLOAD","RAW_DETECTOR_MANIFEST","ANALYSIS_RECEIPT"]}}}},
    "claims":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["claim_id","claim","status","evidence","missing_for_promotion"],"properties":{"claim_id":{"type":"string","minLength":1},"claim":{"type":"string","minLength":1},"status":{"const":"EMPIRICALLY_BOUND_CANDIDATE"},"evidence":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["artifact_id","locator","evidence_kind","effect"],"properties":{"artifact_id":{"type":"string","minLength":1},"locator":{"type":"string","minLength":1},"evidence_kind":{"type":"string","minLength":1},"effect":{"const":"SUPPORTS"}}}},"missing_for_promotion":{"type":"array","items":{"type":"string"}}}}},
    "join_summary":{"type":"object","additionalProperties":false,"required":["packet_status","verified_claims","limited_or_unestablished_claims","admission_decision"],"properties":{"packet_status":{"const":"EMPIRICAL_EVIDENCE_JOIN_V2"},"verified_claims":{"type":"integer","minimum":0},"limited_or_unestablished_claims":{"type":"integer","minimum":0},"admission_decision":{"const":"CANDIDATE_PENDING_POLICY"}}},
    "digest_scope":{"const":"SHA256_OF_RFC8785_CANONICAL_JSON_EXCLUDING_packet_digest_sha256"},
    "packet_digest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
