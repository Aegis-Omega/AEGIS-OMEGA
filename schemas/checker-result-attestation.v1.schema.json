{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-omega.local/schemas/checker-result-attestation.v1.schema.json",
  "title": "CheckerResultAttestationV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attestation_kind",
    "run_id",
    "task_spec_root",
    "trial_index",
    "result_root",
    "checker_commitment",
    "key_id",
    "mac_hex"
  ],
  "properties": {
    "attestation_kind": {"const": "CHECKER_RESULT_ATTESTATION_V1"},
    "run_id": {"type": "string", "minLength": 1},
    "task_spec_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trial_index": {"type": "integer", "minimum": 0},
    "result_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checker_commitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "key_id": {"type": "string", "minLength": 1},
    "mac_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
